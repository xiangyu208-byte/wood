# 对外端口
FRONTEND_PORT=8088
BACKEND_PORT=8080
PYTHON_PORT=8001
DB_PORT=3306

# 数据库（部署前请修改密码）
DB_NAME=wood_detect
DB_USERNAME=wood
DB_PASSWORD=wood_change_me
DB_ROOT_PASSWORD=root_change_me

# 模型文件使用相对于 docker-compose.yml 的路径，也可填写绝对路径
MODEL_PATH=./ultralytics-main/runs/detect/best.pt
MODEL_DEVICE=0
CONFIDENCE_THRESHOLD=0.25
IMAGE_SIZE=640

# 上传限制与时区
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=100MB
TZ=Asia/Shanghai
