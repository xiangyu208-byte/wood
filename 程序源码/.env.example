# 对外端口
FRONTEND_PORT=8088
BACKEND_PORT=8080
PYTHON_PORT=8001
DB_PORT=3306

# 数据库（部署前请修改密码）
DB_NAME=wood_detect
DB_USERNAME=wood
DB_PASSWORD=wood_change_me
DB_ROOT_PASSWORD=root_change_me

# 模型文件使用相对于 docker-compose.yml 的路径，也可填写绝对路径
MODEL_PATH=./ultralytics-main/runs/detect/best.pt
MODEL_DEVICE=0
CONFIDENCE_THRESHOLD=0.25
IMAGE_SIZE=640

# 后端图片校验与批量限制
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,bmp
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=40000000
MAX_BATCH_SIZE=50

# 后端调用推理服务的超时与重试
PYTHON_CONNECT_TIMEOUT=3s
PYTHON_READ_TIMEOUT=120s
PYTHON_MAX_ATTEMPTS=2
PYTHON_RETRY_DELAY=500ms

# 上传限制与时区
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=100MB
TZ=Asia/Shanghai
