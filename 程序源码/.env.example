# 对外端口
FRONTEND_PORT=8088
BACKEND_PORT=8080
PYTHON_PORT=8001
DB_PORT=3306

# 数据库（部署前请修改密码）
DB_NAME=wood_detect
DB_USERNAME=wood
DB_PASSWORD=wood_change_me
DB_ROOT_PASSWORD=root_change_me

# CPU 默认使用 ONNX Runtime；GPU 覆盖配置保留 PyTorch CUDA 权重。
# 路径相对于 docker-compose.yml，也可填写绝对路径。
ONNX_MODEL_PATH=./ultralytics-main/runs/detect/best.onnx
PYTORCH_MODEL_PATH=./ultralytics-main/runs/detect/best.pt
MODEL_DEVICE=0
CONFIDENCE_THRESHOLD=0.25
IMAGE_SIZE=640
FAST_IMAGE_SIZE=512
TILE_IMAGE_SIZE=896
TILE_OVERLAP=0.20
NMS_IOU_THRESHOLD=0.50
AUTO_MAX_DIMENSION=2560
AUTO_PIXEL_COUNT=4000000
AUTO_CONFIDENCE_THRESHOLD=0.55
AUTO_SMALL_BOX_RATIO=0.01
AUTO_EDGE_MARGIN_RATIO=0.02
ANOMALY_FALLBACK_ENABLED=true
ANOMALY_MIN_WOOD_RATIO=0.30
ANOMALY_MIN_COMPONENT_RATIO=0.001
ANOMALY_MAX_COMPONENT_RATIO=0.15
ANOMALY_MAX_CANDIDATES=5

# 后端图片校验与批量限制
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,bmp
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=40000000
MAX_BATCH_SIZE=50

# 后端调用推理服务的超时与重试
PYTHON_CONNECT_TIMEOUT=3s
PYTHON_READ_TIMEOUT=120s
PYTHON_MAX_ATTEMPTS=2
PYTHON_RETRY_DELAY=500ms

# 项目内部质量评分规则（不是行业强制标准）
QUALITY_BASE_SCORE=100
QUALITY_WEIGHT_SPLIT=8
QUALITY_WEIGHT_DRY_KNOT=6
QUALITY_WEIGHT_EDGE_KNOT=5
QUALITY_WEIGHT_WAVE=3
QUALITY_WEIGHT_SOUND_KNOT=2.5
QUALITY_WEIGHT_SMALL_KNOT=2
QUALITY_WEIGHT_SUSPECTED_ANOMALY=2
QUALITY_WEIGHT_UNKNOWN=3
QUALITY_AREA_PENALTY_PER_PERCENT=0.35
QUALITY_MAX_AREA_PENALTY_PER_PERCENT=0.25
QUALITY_TOTAL_AREA_PENALTY_CAP=35
QUALITY_MAX_AREA_PENALTY_CAP=20
QUALITY_GRADE_A_MIN=90
QUALITY_GRADE_B_MIN=75
QUALITY_GRADE_C_MIN=60
QUALITY_RULE_VERSION=WOOD-QS-1.0
QUALITY_DISCLAIMER=质量分级为本项目内部评价规则，仅用于结果比较和人工复核参考，不属于行业强制标准。

# 上传限制与时区
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=100MB
TZ=Asia/Shanghai
